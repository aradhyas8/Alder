<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Alder only loads the torrent engine on API 24 and later. -->
    <uses-sdk tools:overrideLibrary="com.nuvio.engine" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates itself from the GitHub releases (Updates.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Continue Watching on the Google TV home (WatchNext.kt) -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
        <!-- Settings › Video player lists the video apps on this TV (Android 11+ hides other apps without this). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/logo"
        android:theme="@style/Alder"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false">
        <!-- Plain http:// as Stremio allows it: self-hosted add-ons (http://192.168.…:7000), debrid proxies and IPTV
             links. Android 9+ blocks it otherwise, and every such add-on and stream failed. -->
        <!-- Back as a key press on Android 16 too: the player and its panels read KEYCODE_BACK, which Android 16 stops
             sending to apps that target it, so Back left the player with the controls or a panel up. -->

        <activity
            android:name=".ProfilesActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".MainActivity" android:screenOrientation="landscape" />
        <activity android:name=".SearchActivity" android:screenOrientation="landscape" />
        <activity android:name=".SettingsActivity" android:screenOrientation="landscape" />
        <activity android:name=".AddonsActivity" android:screenOrientation="landscape" />
        <activity android:name=".DetailsActivity" android:screenOrientation="landscape" />
        <!-- See-through so the player under it (Change stream) is only paused, not stopped: a stopped player loses its
             picture until Play. No fixed orientation: Android 8.0 refuses one on a see-through screen. -->
        <activity android:name=".StreamsActivity" android:theme="@style/Alder.Over" />
        <activity
            android:name=".PlayerActivity"
            android:theme="@style/Alder.Player"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|smallestScreenSize|screenLayout" />
        <receiver android:name=".Updates$Status" android:exported="false" />
    </application>
</manifest>
