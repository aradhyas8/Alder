<?xml version="1.0" encoding="utf-8"?>
<!-- No backup and no device transfer: profiles keep sign-in keys and PINs, and searches and last-played files are kept
     per profile id, so a restore would hand them to whoever gets that id next (issue 89). allowBackup="false" stops
     cloud backup; on Android 12+ it does not stop device transfer for apps that target 31+, so this file does.
     Every domain is listed: BackupAgent walks shared preferences, databases and files on their own, so excluding
     "root" alone still sends the "account" preferences that hold the keys and PINs. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
